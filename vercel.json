
{
    "rewrites": [
      {
        "source": "/api/:path*",
        "destination": "https://ts.idicorp.ir/api/:path*"
      },
      {
        "source": "/ws/:path*",
        "destination": "https://ts.idicorp.ir/ws/:path*"
      },
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ]
  }
  